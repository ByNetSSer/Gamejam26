    "m_Slots": [
        {
            "m_Id": "1b9faa4371e14146a6f8bdc91e2ba602"
        },
        {
            "m_Id": "eef6a070a4fe47aaa931118ab0afd6b3"
        },
        {
            "m_Id": "35fcd97f523348608ef5c23b439afa87"
        },
        {
            "m_Id": "4db4f9e52700430ba96e784bc3c31abd"
        },
        {
            "m_Id": "739c13f84d6944ff8d0bdbef3bef8123"
        },
        {
            "m_Id": "21d5a2604c9a4e128b90d9081cda293a"
        },
        {
            "m_Id": "753571f427ac4c698013ad9cc9955fb6"
        },
        {
            "m_Id": "f78c3b9c60ec41658687f8258f7361ef"
        },
        {
            "m_Id": "e2ea30a0ddc74e6cb1785173034ba601"
        },
        {
            "m_Id": "a3f9dfba47ee4593ac0486cc933de92e"
        },
        {
            "m_Id": "eb6e75a358704c2891cc9363ab60c2c5"
        },
        {
            "m_Id": "bd38d1b2ad0140378f7a4489e923ce8e"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "BreaFlowMotion",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float period = max(1.0, round(NoiseScale));\nfloat2 direction = normalize(FlowDirection + float2(0.0001, 0.0001));\nfloat flowTime = Seconds * FlowSpeed;\n\nfloat2 p = UV * period + direction * flowTime;\nfloat2 cellA = floor(p);\nfloat2 fracA = frac(p);\nfracA = fracA * fracA * (3.0 - 2.0 * fracA);\nfloat2 a0 = cellA - floor(cellA / period) * period;\nfloat2 a1 = (cellA + float2(1.0, 0.0)) - floor((cellA + float2(1.0, 0.0)) / period) * period;\nfloat2 a2 = (cellA + float2(0.0, 1.0)) - floor((cellA + float2(0.0, 1.0)) / period) * period;\nfloat2 a3 = (cellA + float2(1.0, 1.0)) - floor((cellA + float2(1.0, 1.0)) / period) * period;\nfloat aA = frac(sin(dot(a0, float2(127.1, 311.7))) * 43758.5453);\nfloat bA = frac(sin(dot(a1, float2(127.1, 311.7))) * 43758.5453);\nfloat cA = frac(sin(dot(a2, float2(127.1, 311.7))) * 43758.5453);\nfloat dA = frac(sin(dot(a3, float2(127.1, 311.7))) * 43758.5453);\nfloat nA = lerp(lerp(aA, bA, fracA.x), lerp(cA, dA, fracA.x), fracA.y);\n\nfloat2 q = UV * period + float2(19.17, 43.23) - direction.yx * flowTime * 0.73;\nfloat2 cellB = floor(q);\nfloat2 fracB = frac(q);\nfracB = fracB * fracB * (3.0 - 2.0 * fracB);\nfloat2 b0 = cellB - floor(cellB / period) * period;\nfloat2 b1 = (cellB + float2(1.0, 0.0)) - floor((cellB + float2(1.0, 0.0)) / period) * period;\nfloat2 b2 = (cellB + float2(0.0, 1.0)) - floor((cellB + float2(0.0, 1.0)) / period) * period;\nfloat2 b3 = (cellB + float2(1.0, 1.0)) - floor((cellB + float2(1.0, 1.0)) / period) * period;\nfloat aB = frac(sin(dot(b0, float2(269.5, 183.3))) * 43758.5453);\nfloat bB = frac(sin(dot(b1, float2(269.5, 183.3))) * 43758.5453);\nfloat cB = frac(sin(dot(b2, float2(269.5, 183.3))) * 43758.5453);\nfloat dB = frac(sin(dot(b3, float2(269.5, 183.3))) * 43758.5453);\nfloat nB = lerp(lerp(aB, bB, fracB.x), lerp(cB, dB, fracB.x), fracB.y);\n\nfloat2 detailFrequencyA = float2(max(1.0, round(period * 1.3333)), max(1.0, round(period * 0.8333)));\nfloat2 detailFrequencyB = float2(max(1.0, round(period * 0.5)), max(1.0, round(period * 1.1667)));\nfloat detailA = dot(UV, detailFrequencyA) * 6.283185 + Seconds * DetailSpeed * 6.283185;\nfloat detailB = dot(UV, float2(-detailFrequencyB.x, detailFrequencyB.y)) * 6.283185 - Seconds * DetailSpeed * 4.712389;\nfloat detail = sin(detailA) * cos(detailB);\n\nfloat2 warp = (float2(nA, nB) - 0.5) * DistortionStrength;\nUVOut = UV + warp + direction * detail * DistortionStrength * DetailStrength;\nfloat localPhase = (nA + nB) * PhaseVariation * 6.283185;\nPulse = sin(Seconds * BubbleSpeed + localPhase) + detail * DetailStrength;"
}

