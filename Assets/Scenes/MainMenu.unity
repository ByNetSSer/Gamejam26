  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>F\xC1CIL</b>\nPara principiantes: disfruta el descenso sin tanta presi\xF3n.
    Precios accesibles, torres que crecen con calma y pu\xF1etazos para repartir.
    Eso s\xED... no te acostumbres demasiado."
